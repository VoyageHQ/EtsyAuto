# ---------------------------------------------------------------------------
# EtsyAuto configuration. Copy to `.env` and fill in only what you need.
# Every single value here is optional. With an empty .env the whole system
# still runs: agents fall back to the offline brain and design locally.
# ---------------------------------------------------------------------------

# Shop identity -------------------------------------------------------------
SHOP_NAME=Hartistic
VALLEY_NAME=Hartistic Valley
SHOP_CURRENCY=GBP

# Dashboard -----------------------------------------------------------------
PORT=4173
HOST=127.0.0.1

# Agent brain ---------------------------------------------------------------
# LLM_PROVIDER=offline        -> no API, no cost. Uses built-in idea corpus
#                                and rule-based writing. Good for testing.
# LLM_PROVIDER=anthropic      -> needs ANTHROPIC_API_KEY.
# LLM_PROVIDER=openai         -> any OpenAI-compatible endpoint, which
#                                includes free local Ollama and free tiers
#                                of Groq / OpenRouter. Needs LLM_BASE_URL.
LLM_PROVIDER=offline

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# For LLM_PROVIDER=openai. Anything OpenAI-shaped works, including every free
# option below. The agents ask for JSON constantly, so a model that holds a
# format matters more here than one that writes beautifully.
#
# Local, via Ollama — free forever, nothing leaves your machine:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=hermes3            ~5GB, tuned for structured output
#   LLM_MODEL=qwen2.5:14b        ~9GB, better prose, needs 16GB RAM
#   LLM_MODEL=llama3.1           ~5GB, the safe default
#   (no LLM_API_KEY needed)
#
# OpenRouter free tier — nothing to install, rate limited, needs a key:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
#   LLM_API_KEY=sk-or-…
#
# Groq free tier — very fast, rate limited, needs a key:
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# A rail on your wallet. When the day's tokens are spent the agents fall back
# to their offline craft instead of spending more, so nothing stops.
# 0 or blank means no cap.
LLM_DAILY_TOKENS=0
# Optional: your model's rates per million tokens, so the Office shows the
# meter in money as well as tokens. Rates change too often to hard-code.
LLM_COST_IN=0
LLM_COST_OUT=0

# Autonomy ------------------------------------------------------------------
# How hard the fleet works on its own. Nothing is ever published without
# your approval regardless of this setting.
AUTO_LOOP=true
TICK_SECONDS=20
# How big the shortlist on the Research Bench is kept. The Scout never stops
# proposing; when the list is full the weakest make way, so the pile stays the
# same size and gets better rather than longer. Shelved ideas stay in the
# Library and you can bring any of them back.
IDEA_BACKLOG_TARGET=18
# How often the Scout is asked for a fresh batch.
IDEA_ASK_MINUTES=30
# The Scout's notebook holds concepts this engine cannot make — Notion
# workspaces, Cricut cut files, presets, wall art. They stay there, marked,
# rather than being proposed: a title promising a Notion file that ships a PDF
# is a refund waiting to happen. Turn this on if you will supply the artwork or
# the file yourself and just want the ideas.
PROPOSE_ARTWORK=false
# How often the Researcher reads Etsy's own live listings for the phrases this
# shop is betting on: how crowded each one is, what it costs, which words the
# ranking titles use. This is the only research here that is not a guess, and
# it needs nothing but ETSY_KEYSTRING — no shop, no sign-in.
MARKET_SCAN_HOURS=3
# How many products may be in production at once.
MAX_ACTIVE_PRODUCTS=3

# Discord -------------------------------------------------------------------
# Leave DISCORD_BOT_TOKEN blank to disable Discord entirely.
# See docs/DISCORD.md for the 5 minute setup.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Category the per-agent channels get created under. Created if missing.
DISCORD_CATEGORY_NAME=Hartistic Valley
# Your Discord user id, so agents can @you when they need a decision.
DISCORD_OWNER_ID=

# One bot account per agent, so each appears as its own member with its own
# name and avatar. Run `npm run discord:setup` for the walkthrough. Any agent
# without its own token posts through a webhook on the shared bot instead.
DISCORD_TOKEN_MANAGER=
DISCORD_TOKEN_SCOUT=
DISCORD_TOKEN_RESEARCHER=
DISCORD_TOKEN_MAKER=
DISCORD_TOKEN_COPYWRITER=
DISCORD_TOKEN_QA=
DISCORD_TOKEN_LISTER=
DISCORD_TOKEN_CURATOR=
# The venture arm's agents.
DISCORD_TOKEN_HARBOURMASTER=
DISCORD_TOKEN_PROSPECTOR=
DISCORD_TOKEN_ANALYST=
DISCORD_TOKEN_ARCHITECT=
DISCORD_TOKEN_BUILDER=
DISCORD_TOKEN_MARKETER=

# The venture arm ----------------------------------------------------------
# The second business: startup ideas found in public discussions, validated,
# built as an MVP and marketed. Same dashboard, shares no data with the shop.
# See docs/VENTURES.md.

# Which research sources the Prospector may use.
#   hackernews  free public API, no key, works everywhere
#   reddit      public .json endpoints; register a script app for heavy use
#   rss         any forum or blog feed you list below
# Where the Prospector listens. All of these are free and none needs a key.
#   hackernews     public Algolia search. Reliable, indexes every comment.
#   stackexchange  softwarerecs, webapps, superuser — people asking for tools
#                  that do not exist, with view counts as demand.
#   discourse      any Discourse community you name below. The widest source
#                  there is, and the one you steer.
#   github         feature requests nobody has built. Reactions are "me too".
#   lobsters       small, technical, low noise.
#   reddit         works from a home connection; blocks most servers.
#   rss            any feed you list in VENTURE_FEEDS.
VENTURE_SOURCES=hackernews,stackexchange,discourse,github,lobsters

# Discourse communities to listen to, comma separated, hostname only.
# This is the dial that decides whether it hears your customers or strangers.
# Find them by searching "<your niche> discourse forum" — most niches have one.
VENTURE_FORUMS=meta.discourse.org,forum.obsidian.md,community.notion.so

# Optional. Unauthenticated GitHub search allows ten requests a minute, which
# is plenty at this pace; a token raises it to thirty.
GITHUB_TOKEN=

# Which communities to listen to. Pick ones whose members have problems you
# could actually solve — broad defaults give broad results.
VENTURE_SUBREDDITS=smallbusiness,Entrepreneur,SaaS,freelance,sysadmin,accounting

# Any RSS or Atom feeds, comma separated.
VENTURE_FEEDS=

# Optional. Reddit works without this for modest use.
REDDIT_TOKEN=

# How many ventures may be in build at once. One is the honest answer.
VENTURE_MAX_ACTIVE=1
# The Analyst kills anything with no plausible first payment within this many
# days. Ideas that cannot pass this are hobbies, not businesses.
VENTURE_MAX_DAYS_TO_REVENUE=90
VENTURE_DIR=ventures

# Etsy --------------------------------------------------------------------
# Optional. Without these, the Lister exports a ready-to-upload folder in
# out/ instead of talking to Etsy. See docs/PUBLISHING.md.
# --- protecting your listing images ---------------------------------------
# For a printable the preview images are the product, so they carry a faint
# tiled mark. Point SHOP_LOGO at your own logo to use that instead of the shop
# name. 0.1 is barely visible to a buyer and still ruins a screenshot; raise it
# if you would rather be safe than subtle. WATERMARK=off removes it entirely.
SHOP_LOGO=
WATERMARK_OPACITY=0.1
WATERMARK=on

ETSY_KEYSTRING=
# Needed while your app is in developer mode: Etsy refuses the keystring on its
# own and wants keystring:shared_secret in the x-api-key header. Harmless once
# the app is approved — npm run etsy:check works out which form yours needs.
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
# Safety rail: `draft` never puts a listing on sale, only in your drafts.
ETSY_PUBLISH_MODE=draft
# The circuit breaker, not a speed limit. Every upload already needs a decision
# from you that is spent when it is used; this is only here to catch a bug that
# finds a way to mint those decisions in a loop.
ETSY_MAX_UPLOADS_PER_HOUR=30
