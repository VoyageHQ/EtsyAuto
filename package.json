{
  "name": "etsyauto",
  "version": "0.1.0",
  "private": true,
  "description": "An AI agent fleet that invents, designs and lists digital products for an Etsy shop, run from a pixel-valley dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dashboard": "node --disable-warning=ExperimentalWarning src/index.js --no-loop",
    "ideas": "node --disable-warning=ExperimentalWarning src/cli.js ideas",
    "queue": "node --disable-warning=ExperimentalWarning src/cli.js queue",
    "approve": "node --disable-warning=ExperimentalWarning src/cli.js approve",
    "reject": "node --disable-warning=ExperimentalWarning src/cli.js reject",
    "answer": "node --disable-warning=ExperimentalWarning src/cli.js answer",
    "status": "node --disable-warning=ExperimentalWarning src/cli.js status",
    "teach": "node --disable-warning=ExperimentalWarning src/cli.js teach",
    "make": "node --disable-warning=ExperimentalWarning src/cli.js make",
    "list": "node --disable-warning=ExperimentalWarning src/cli.js list",
    "reset": "node --disable-warning=ExperimentalWarning src/cli.js reset",
    "discord:setup": "node --disable-warning=ExperimentalWarning scripts/discord-setup.js",
    "brain:check": "node --disable-warning=ExperimentalWarning scripts/brain-check.js",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.js",
    "etsy:auth": "node --disable-warning=ExperimentalWarning scripts/etsy-auth.js",
    "etsy:check": "node --disable-warning=ExperimentalWarning scripts/etsy-check.js",
    "etsy:push": "node --disable-warning=ExperimentalWarning scripts/etsy-push.js",
    "etsy:cleanup": "node --disable-warning=ExperimentalWarning scripts/etsy-cleanup.js",
    "tidy": "node --disable-warning=ExperimentalWarning scripts/tidy.js",
    "etsy:redraft": "node --disable-warning=ExperimentalWarning scripts/etsy-redraft.js",
    "test": "node --disable-warning=ExperimentalWarning test/run.js smoke",
    "audit": "node --disable-warning=ExperimentalWarning test/run.js audit",
    "audit:ui": "node --disable-warning=ExperimentalWarning test/run.js ui",
    "check": "npm test && npm run audit && npm run audit:ui",
    "knowledge": "node --disable-warning=ExperimentalWarning src/cli.js knowledge",
    "digest": "node --disable-warning=ExperimentalWarning src/cli.js digest",
    "health": "node --disable-warning=ExperimentalWarning src/cli.js health",
    "seo": "node --disable-warning=ExperimentalWarning src/cli.js seo",
    "backup": "node --disable-warning=ExperimentalWarning src/cli.js backup",
    "restore": "node --disable-warning=ExperimentalWarning src/cli.js restore"
  },
  "dependencies": {},
  "devDependencies": {}
}
